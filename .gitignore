# Dependencies
node_modules/

# Build artifacts
dist/
src-tauri/target/
# gen/ генерируется Tauri (iOS/Android-проекты), но Android-проект трекаем —
# там кастомные файлы виджета (Kotlin, layout, манифест), которые иначе
# перетираются при `tauri android init`.
src-tauri/gen/*
!src-tauri/gen/android/
# Сборочные артефакты Android-проекта игнорируем.
src-tauri/gen/android/app/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/local.properties

# Superpowers brainstorming (ephemeral)
/.superpowers/

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# Legacy Flutter artifacts (build cache)
legacy/flutter-mvp/.dart_tool/
legacy/flutter-mvp/build/

# Сборочный каталог виджета (swiftc-артефакты .appex)
src-tauri/build/
