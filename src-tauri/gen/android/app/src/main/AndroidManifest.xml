<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET ОБЯЗАТЕЛЕН для любого Tauri v2 приложения на Android:
         WebView загружает интерфейс через встроенный HTTP-сервер
         (http://tauri.localhost) и общается с Rust-ядром через IPC
         (http://ipc.localhost). Android блокирует ВСЕ сетевые сокеты —
         включая localhost — без этого разрешения, поэтому без него
         приложение не стартует (белый экран). Соединений наружу нет. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Перезагрузка Android: виджеты и уведомления восстанавливают таймеры
         (самообновление виджета через AlarmManager; планировщик уведомлений
         плагина). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.daily_planner"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- Диалог быстрого добавления задачи из виджета («＋»): лёгкая
             Activity без WebView — работает, даже если приложение не запущено.
             exported=false: вызывается только PendingIntent'ами из своих
             виджетов. -->
        <activity
            android:name=".QuickAddActivity"
            android:theme="@style/QuickAddTheme"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- Действия виджетов (тайный receiver): отметка «выполнено» тапом по
             строке, стрелки ‹ › переключения дня, возврат на сегодня.
             exported=false: только PendingIntent'ы из своих виджетов. -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />

        <!-- Пять виджетов: «Сегодня» (2×2–4×4, стрелки ‹ ›), «Неделя»
             (4×2–4×4), «Когда-нибудь» (2×2–4×4), «Следующая задача» (2×1),
             «Мини-счётчик» (1×1). Читают files/widget.json (пишет Rust).
             label — имя в галерее виджетов; BOOT_COMPLETED — восстановление
             самообновления после перезагрузки. -->
        <receiver
          android:name=".DayWidgetProvider"
          android:exported="true"
          android:label="@string/widget_day_label">
          <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          </intent-filter>
          <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_day_info" />
        </receiver>

        <receiver
          android:name=".WeekWidgetProvider"
          android:exported="true"
          android:label="@string/widget_week_label">
          <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          </intent-filter>
          <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_week_info" />
        </receiver>

        <receiver
          android:name=".SomedayWidgetProvider"
          android:exported="true"
          android:label="@string/widget_someday_label">
          <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          </intent-filter>
          <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_someday_info" />
        </receiver>

        <receiver
          android:name=".NextWidgetProvider"
          android:exported="true"
          android:label="@string/widget_next_label">
          <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          </intent-filter>
          <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_next_info" />
        </receiver>

        <receiver
          android:name=".CounterWidgetProvider"
          android:exported="true"
          android:label="@string/widget_counter_label">
          <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          </intent-filter>
          <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_counter_info" />
        </receiver>
    </application>
</manifest>
