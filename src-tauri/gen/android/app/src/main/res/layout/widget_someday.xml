<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Позже» (4×2): заголовок + 5 строк задач без даты. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_light"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Позже" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/widget_muted_light"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_add_bg"
            android:text="+"
            android:textColor="@color/widget_on_accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:contentDescription="Добавить задачу" />
    </LinearLayout>

    <!-- 5 строк задач (у задач «Позже» времени обычно нет). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="5dp">
        <TextView
            android:id="@+id/task_time1"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_light"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp">
        <TextView
            android:id="@+id/task_time2"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_light"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp">
        <TextView
            android:id="@+id/task_time3"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_title3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_light"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp">
        <TextView
            android:id="@+id/task_time4"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_title4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_light"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp">
        <TextView
            android:id="@+id/task_time5"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_title5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_light"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Строки 6–7: только в больших размерах (4×3 и выше). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp">
        <TextView
            android:id="@+id/task_time6"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_title6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_light"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp">
        <TextView
            android:id="@+id/task_time7"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_title7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_light"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
