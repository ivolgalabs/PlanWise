<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Задачи на сегодня"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1F2329"
        android:paddingBottom="6dp" />

    <TextView android:id="@+id/widget_task1" style="@style/WidgetTaskLine" />
    <TextView android:id="@+id/widget_task2" style="@style/WidgetTaskLine" />
    <TextView android:id="@+id/widget_task3" style="@style/WidgetTaskLine" />
    <TextView android:id="@+id/widget_task4" style="@style/WidgetTaskLine" />
    <TextView android:id="@+id/widget_task5" style="@style/WidgetTaskLine" />
    <TextView android:id="@+id/widget_task6" style="@style/WidgetTaskLine" />
</LinearLayout>
