<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Виджет — песочница (как все WidgetKit-расширения) + App Group:
	     через неё читает widget.json, который пишет Rust-приложение. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.zkproject.dailyplanner</string>
	</array>
</dict>
</plist>
