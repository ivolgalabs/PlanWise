{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:read-files",
    "fs:write-files",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**",
        "$APPDATA/**",
        "$CACHE/**",
        "$DOWNLOAD/**",
        "$DOCUMENT/**",
        "$PICTURE/**"
      ]
    },
    "opener:default",
    "opener:allow-open-path"
  ]
}